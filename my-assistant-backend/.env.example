# ==============================================================================
# MY ASSISTANT & GATE CS PREPARATION BACKEND CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider: 'openrouter' or 'groq' (defaults to 'openrouter' if OPENROUTER_API_KEY is present)
LLM_PROVIDER=openrouter

# OpenRouter (Supports NVIDIA Nemotron, DeepSeek, Llama 3.3, etc.)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Groq (Alternative / Fallback)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Desktop Local Model (Optional llama.cpp runner)
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_RUNNER_PATH=

# ------------------------------------------------------------------------------
# 2. Vector Store & Database (Supabase + pgvector)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_or_secret_key

# ------------------------------------------------------------------------------
# 3. Google Drive Document Sync
# ------------------------------------------------------------------------------
# Service account JSON string or path to service account file
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=your_shared_folder_id_here
ADMIN_EMAIL=your_login_email_here

# ------------------------------------------------------------------------------
# 4. Public APIs - Coding, Math & Academic (public-apis/public-apis)
# ------------------------------------------------------------------------------
# Wandbox: Open remote code execution for C, C++, Python (no key required)
WANDBOX_API_URL=https://wandbox.org/api/compile.json

# Judge0 CE: Open code execution engine
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Piston: Code execution engine (emkc.org public endpoint or self-hosted)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Newton: Symbolic math, calculus, derivatives & simplification
NEWTON_MATH_API_URL=https://newton.vercel.app/api/v2

# Math.js API: Expression evaluation and matrix operations
MATHJS_API_URL=https://api.mathjs.org/v4

# arXiv: Computer science preprints & academic research papers
ARXIV_API_URL=https://export.arxiv.org/api/query

# Stack Exchange API: Computer science & programming doubt discussions
STACKEXCHANGE_API_URL=https://api.stackexchange.com/2.3
STACKEXCHANGE_API_KEY=

# ------------------------------------------------------------------------------
# 5. Public APIs - Books, Reference & Syllabus
# ------------------------------------------------------------------------------
# Open Library: Standard CS textbook metadata, editions, authors & covers
OPEN_LIBRARY_API_URL=https://openlibrary.org

# Google Books (Optional alternative for book previews)
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1/volumes
GOOGLE_BOOKS_API_KEY=

# Wikipedia REST API: Instant definitions & summaries for CS concepts
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1

# ------------------------------------------------------------------------------
# 6. Public APIs - General Aptitude & Vocabulary (GATE GA Section)
# ------------------------------------------------------------------------------
# Datamuse: Word associations, synonyms, antonyms, rhyming & vocabulary builder
DATAMUSE_API_URL=https://api.datamuse.com

# Free Dictionary API: Definitions, pronunciations and parts of speech
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# ------------------------------------------------------------------------------
# 7. Public APIs - Productivity, Motivation & Assistant Tools
# ------------------------------------------------------------------------------
# Open-Meteo: High-accuracy weather & air quality forecast (100% free, no key needed)
OPEN_Meteo_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# OpenWeatherMap (Legacy weather key, optional)
weather=your_openweathermap_key_here

# ZenQuotes: Daily motivational and focus quotes for study streaks
ZENQUOTES_API_URL=https://zenquotes.io/api
ZENQUOTES_API_KEY=

# Quotable API (Alternative quotes engine)
QUOTABLE_API_URL=https://api.quotable.io

# Nager.Date: Public & national holidays API for study timetable & revision planner
NAGER_DATE_API_URL=https://date.nager.at/api/v3

# Hacker News API: Tech news & engineering updates for community feed
HACKER_NEWS_API_URL=https://hacker-news.firebaseio.com/v0
